<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12.0" prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.tallerbicicletas.controller.MecanicoViewController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Mecánicos" style="-fx-font-size: 18px; -fx-font-weight: bold;" />


        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Identificación:" prefWidth="140.0" />
                <TextField fx:id="txtId" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Nombre Completo:" prefWidth="140.0" />
                <TextField fx:id="txtNombre" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="N° Certificado:" prefWidth="140.0" />
                <TextField fx:id="txtNumeroCertificado" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Especialidad:" prefWidth="140.0" />
                <ComboBox fx:id="cbEspecialidad" prefWidth="250.0" />
            </children>
        </HBox>


        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button text="Guardar Mecánico" onAction="#onAgregarMecanico" />
                <Button text="Volver" onAction="#onVolver" />
            </children>
        </HBox>


        <TableView fx:id="tblMecanicos" prefHeight="250.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="Identificación" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colNumeroCertificado" prefWidth="150.0" text="N° Certificado" />
                <TableColumn fx:id="colEspecialidad" prefWidth="150.0" text="Especialidad" />
            </columns>
        </TableView>
    </children>
</VBox>