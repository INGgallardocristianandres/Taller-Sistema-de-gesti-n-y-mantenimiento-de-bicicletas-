<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12.0" prefHeight="650.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.tallerbicicletas.controller.RepuestoViewController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Repuestos" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <!-- Campos del Formulario -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Código:" prefWidth="150.0" />
                <TextField fx:id="txtCodigo" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Nombre del Repuesto:" prefWidth="150.0" />
                <TextField fx:id="txtNombre" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Precio ($):" prefWidth="150.0" />
                <TextField fx:id="txtPrecio" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Stock Actual:" prefWidth="150.0" />
                <TextField fx:id="txtStockActual" prefWidth="250.0" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Stock Mínimo:" prefWidth="150.0" />
                <TextField fx:id="txtStockMinimo" prefWidth="250.0" />
            </children>
        </HBox>

        <!-- Botones de Acción -->
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button text="Guardar Repuesto" onAction="#onAgregarRepuesto" />
                <Button text="Volver" onAction="#onVolver" />
            </children>
        </HBox>

        <!-- Tabla de Repuestos -->
        <TableView fx:id="tblRepuestos" prefHeight="250.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio" />
                <TableColumn fx:id="colStockActual" prefWidth="120.0" text="Stock Actual" />
                <TableColumn fx:id="colStockMinimo" prefWidth="120.0" text="Stock Mínimo" />
            </columns>
        </TableView>
    </children>
</VBox>