<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="12.0" prefHeight="550.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.tallerbicicletas.controller.BicicletaViewController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label text="Gestión de Bicicletas" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Serial:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtSerial" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Marca:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtMarca" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbTipo" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Color:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtColor" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtAnio" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Propietario:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <ComboBox fx:id="cbPropietario" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </children>
        </GridPane>

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button text="Agregar Bicicleta" onAction="#onAgregarBicicleta" />
                <Button text="Volver" onAction="#onVolver" />
            </children>
        </HBox>

        <TableView fx:id="tblBicicletas" prefHeight="200.0" prefWidth="560.0">
            <columns>
                <TableColumn fx:id="colSerial" text="Serial" prefWidth="90.0" />
                <TableColumn fx:id="colMarca" text="Marca" prefWidth="90.0" />
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="90.0" />
                <TableColumn fx:id="colColor" text="Color" prefWidth="80.0" />
                <TableColumn fx:id="colAnio" text="Año" prefWidth="60.0" />
                <TableColumn fx:id="colPropietario" text="Propietario" prefWidth="140.0" />
            </columns>
        </TableView>
    </children>
</VBox>